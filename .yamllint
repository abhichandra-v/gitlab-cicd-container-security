---
extends: default

ignore: |
  .go/
  .cache/
  reports/
  rendered/

rules:
  line-length:
    max: 160
  # Only real booleans; "yes"/"on" are too easy to misread.
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: true
